# Copy to .env and fill in. Never commit .env.
#
# Precedence: this file is loaded by python-dotenv with `load_dotenv(override=False)`
# (src/utils/settings.py, the one place `.env` is read), so a REAL environment
# variable always wins over the value written here. Exporting OPENAI_API_KEY,
# EMBEDDING_PROVIDER or MOCK_LLM on the host overrides this file — which is how CI
# and a grader's machine inject a key without editing `.env`.

# --- LLM gateway (ADR-005): chat ---
# Chat: any OpenAI-compatible endpoint. Leave base URL empty for api.openai.com.
#   OpenAI      (default)   https://api.openai.com/v1
#   Groq        chat only   https://api.groq.com/openai/v1
#   Ollama                  http://localhost:11434/v1
#   vLLM                    http://localhost:8000/v1
#
# The chat credential and endpoint are resolved first-hit-wins:
#   key:      LLM_API_KEY  -> OPENAI_API_KEY -> GROQ_API_KEY
#   base URL: LLM_BASE_URL -> OPENAI_BASE_URL -> Groq's URL when the key came from
#             GROQ_API_KEY and no base URL is set anywhere
# The model has NO LLM_* alias: OPENAI_MODEL is protocol-named (the OpenAI-compatible
# wire format), not vendor-named, so it already addresses Groq, NVIDIA and Ollama
# models without a second spelling. Resolution: OPENAI_MODEL -> built-in default (a
# per-call model override in the UI still wins).
#
# WHY THE LLM_* NAMES EXIST: real environment variables beat this file (see the top
# of this file). On a machine that already exports OPENAI_API_KEY / OPENAI_BASE_URL —
# this host does, with an NVIDIA key — whatever you write in OPENAI_* below is
# SILENTLY IGNORED and the request goes out with the ambient credentials. Use the
# LLM_* names there: they take precedence, so the credential you mean is the one used.
#
# Groq in one variable: setting only GROQ_API_KEY runs chat against Groq, because the
# base URL follows the key (https://api.groq.com/openai/v1).
#
# Groq serves chat only: its API reference exposes chat + responses and NO
# /embeddings endpoint, so a Groq chat config must pair with EMBEDDING_PROVIDER=local
# (or an OpenAI / Ollama / vLLM EMBEDDING_BASE_URL below). Chat and embeddings are
# allowed to be different providers.
#
# Pick a Groq model that supports Structured Outputs: analyze_question and
# groundedness_check need response_format=json_schema, and most Groq models do not
# support it at all. openai/gpt-oss-120b is the recommended one (it supports
# strict:true; the gateway sends no `strict` key, so it runs best-effort and the
# gateway validates the JSON against the schema client-side and retries once).
# A model still has to be named — the built-in default is not a Groq model.
#
# Groq example — two variables plus the embedder:
#   GROQ_API_KEY=gsk_...            # base URL follows the key
#   OPENAI_MODEL=openai/gpt-oss-120b
#   EMBEDDING_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=

# --- Embeddings (dense retrieval; used by scripts/build_index.py and uploads) ---
# Which embedder the dense leg uses:
#   local (default) = a local Hugging Face model run in-process on ONNX Runtime via
#                     fastembed: no API key, no /embeddings endpoint, no torch.
#   api             = any OpenAI-compatible /embeddings endpoint (below).
# MOCK_LLM=1 overrides both with the deterministic offline sha256 embedder (CI path).
#
# Changing the provider or model changes the vector width, which invalidates any
# index built with the old one. Build into a fresh `--index-dir` or delete data/index/;
# the loader fails loudly on a width mismatch rather than returning garbage.
EMBEDDING_PROVIDER=local

# Read only when EMBEDDING_PROVIDER=local. 384-dim; ~150 MB downloaded and cached on
# first use (ONNX Runtime, no PyTorch).
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Read only when EMBEDDING_PROVIDER=api. Defaults to the chat base URL above; set it
# explicitly when the chat provider has no /embeddings endpoint (the Groq case).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Keyless demo: 1 = deterministic scripted LLM + offline embedder, no network
# (also used by graph tests and CI). Checked BEFORE EMBEDDING_PROVIDER, so it wins.
# NOTE: this repo's own `.env` ships MOCK_LLM=1, so the EMBEDDING_PROVIDER=local
# default above is only exercised with MOCK_LLM=0 or unset.
MOCK_LLM=0

# --- Runtime ---
DATA_DIR=./data
LOG_JSON=1

# Optional observability (ADR-007) — off by default, needs an account+key
LANGSMITH_TRACING=false

# Retrieval (ADR-002)
RETRIEVAL_K=8
