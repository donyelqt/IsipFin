# Copy to .env and fill in. Never commit .env.

# --- LLM gateway (ADR-005) ---
# Any OpenAI-compatible endpoint. Leave base URL empty for api.openai.com.
# Local examples: http://localhost:11434/v1 (Ollama), http://localhost:8000/v1 (vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Keyless demo: 1 = deterministic scripted LLM, no network (also used by graph tests)
MOCK_LLM=0

# --- Runtime ---
DATA_DIR=./data
LOG_JSON=1

# Optional observability (ADR-007) — off by default, needs an account+key
LANGSMITH_TRACING=false

# Retrieval (ADR-002)
RETRIEVAL_K=8
