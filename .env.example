# Copy to .env and fill in. Never commit .env.
#
# This file is loaded by python-dotenv with `load_dotenv(override=False)`
# (src/utils/settings.py, the one place `.env` is read), so as a rule a REAL environment
# variable wins over what is written here: exporting EMBEDDING_PROVIDER or MOCK_LLM on the
# host overrides this file, which is how CI and a grader's machine inject a value without
# editing it.
#
# One deliberate exception, and it is narrow: the names that decide WHICH PROVIDER a
# request is aimed at — LLM_PROVIDER, LLM_API_KEY, LLM_BASE_URL, LLM_MODEL and their
# OPENAI_* / GROQ_* aliases — are authoritative in the file, so a credential you typed
# here is never silently overridden by an unrelated export on the host. A blank value
# below still means "unset here" and never clobbers a real one.

# --- LLM gateway: chat (ADR-005) ---
# Chat is one OpenAI-compatible client. Four names are the documented surface, one per
# setting — pick the provider, then give it a key:
#
#   LLM_PROVIDER  which provider: openai (default) · groq · nvidia · ollama · vllm · azure
#   LLM_API_KEY   the key — the ONE credential to fill in
#   LLM_BASE_URL  endpoint override for a custom / Azure / self-hosted endpoint (optional;
#                 leave empty to use the provider's own endpoint above)
#   LLM_MODEL     the model id (optional; a per-call model override in the UI still wins)
#
# Aliases, lower precedence than LLM_*: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL and
# GROQ_API_KEY (a key that also implies LLM_PROVIDER=groq). They exist so a host that
# already exports OPENAI_* keeps working; prefer LLM_* when you have the choice.
# Leaving LLM_PROVIDER blank keeps that default: openai, or Groq when the key came from
# GROQ_API_KEY.
#
# LLM_MODEL is the primary name for the model, and OPENAI_MODEL is an accepted alias at a
# lower precedence. The two are not redundant: OPENAI_* describes the OpenAI-compatible
# WIRE PROTOCOL rather than a vendor, so one spelling already addresses Groq, NVIDIA,
# Ollama and vLLM models — a rationale that explains why the alias stays, not why the
# LLM_* name would be withheld. Set whichever you have; LLM_* wins if you set both.
#
# MOCK_LLM=1 (below) is checked before these and needs no key at all.
#
# Groq pairs with LOCAL embeddings: Groq's API has chat and responses but no /embeddings
# endpoint, so a Groq chat config must use EMBEDDING_PROVIDER=local (the default) or an
# EMBEDDING_BASE_URL below that actually serves /embeddings. Chat and embeddings are
# allowed to be different providers.
#
# Groq also gates Structured Outputs by model: analyze_question and groundedness_check
# send response_format=json_schema, and only a few Groq models accept it. strict:true is
# available on openai/gpt-oss-20b, openai/gpt-oss-120b and qwen/qwen3.8-27b; best-effort on
# those plus openai/gpt-oss-safeguard-20b. Every other Groq model — including
# llama-3.3-70b-versatile — rejects json_schema outright and would break both JSON nodes,
# so the model name is not free choice on Groq. The gateway sends no `strict` key, so on
# Groq it runs best-effort and validates the JSON against the schema client-side, retrying
# once before failing the node.
#
# Groq — three lines (the provider selects Groq's endpoint, so no base URL):
#   LLM_PROVIDER=groq
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=openai/gpt-oss-120b
#
# OpenAI — three lines (the provider selects api.openai.com, so no base URL):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Aliases — read only when the matching LLM_* name above is unset. Kept here because
# hosts (including this one, with an NVIDIA key) export OPENAI_*; a value you write for
# an LLM_* name takes precedence, so the credential you mean is the one used.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GROQ_API_KEY=

# --- Embeddings (dense retrieval; used by scripts/build_index.py and uploads) ---
# Which embedder the dense leg uses:
#   local (default) = a local Hugging Face model run in-process on ONNX Runtime via
#                     fastembed: no API key, no /embeddings endpoint, no torch.
#   api             = any OpenAI-compatible /embeddings endpoint (below).
# MOCK_LLM=1 overrides both with the deterministic offline sha256 embedder (CI path).
#
# Changing the provider or model changes the vector width, which invalidates any
# index built with the old one. Build into a fresh `--index-dir` or delete data/index/;
# the loader fails loudly on a width mismatch rather than returning garbage.
EMBEDDING_PROVIDER=local

# Read only when EMBEDDING_PROVIDER=local. 384-dim; ~150 MB downloaded and cached on
# first use (ONNX Runtime, no PyTorch).
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Read only when EMBEDDING_PROVIDER=api. Defaults to the chat base URL above; set it
# explicitly when the chat provider has no /embeddings endpoint (the Groq case).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Keyless demo: 1 = deterministic scripted LLM + offline embedder, no network
# (also used by graph tests and CI). Checked BEFORE EMBEDDING_PROVIDER, so it wins.
# NOTE: this repo's own `.env` ships MOCK_LLM=1, so the EMBEDDING_PROVIDER=local
# default above is only exercised with MOCK_LLM=0 or unset.
MOCK_LLM=0

# --- Runtime ---
DATA_DIR=./data
LOG_JSON=1

# Optional observability (ADR-007) — off by default, needs an account+key
LANGSMITH_TRACING=false

# Retrieval (ADR-002)
RETRIEVAL_K=8
