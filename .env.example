# Copy to .env and fill in. Never commit .env.

# --- LLM gateway (ADR-005) ---
# Chat: any OpenAI-compatible endpoint. Leave base URL empty for api.openai.com.
#   OpenAI      (default)
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
#   vLLM        http://localhost:8000/v1
# NOTE: Groq serves chat only — it has NO embeddings endpoint. Point the embedder
# at OpenAI, Ollama, or vLLM (EMBEDDING_BASE_URL below); chat and embeddings may
# legitimately use different providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (used by scripts/build_index.py) ---
# Must be a provider that actually exposes /embeddings. Defaults to the chat
# provider's base URL; override when the chat provider has none (see Groq note).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Keyless demo: 1 = deterministic scripted LLM, no network (also used by graph tests)
MOCK_LLM=0

# --- Runtime ---
DATA_DIR=./data
LOG_JSON=1

# Optional observability (ADR-007) — off by default, needs an account+key
LANGSMITH_TRACING=false

# Retrieval (ADR-002)
RETRIEVAL_K=8
